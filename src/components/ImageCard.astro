---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  id: string;
  src: ImageMetadata;
  title: string;
  caption?: string;
  link?: string;
  tags: string[];
  groupTitle: string;
  groupSlug: string;
}

const { id, src, title, caption, link, tags, groupTitle, groupSlug } =
  Astro.props;

const search = [groupTitle, caption, title, ...tags]
  .filter(Boolean)
  .join(" ")
  .toLowerCase();
---

<li class="card-wrapper" data-tags={tags.join(",")} data-search={search}>
  <button type="button" class="card" data-lightbox-trigger={id}>
    <Image
      src={src}
      alt={title}
      width={520}
      height={Math.round((520 * src.height) / src.width)}
      loading="lazy"
    />
    <div class="card-body">
      <p class="card-group">{groupTitle}</p>
      {caption && <p class="card-caption">{caption}</p>}
      <div class="card-tags">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </div>
  </button>

  <div data-lightbox-content={id} hidden>
    <Image
      src={src}
      alt={title}
      width={1000}
      height={Math.round((1000 * src.height) / src.width)}
    />
    <div class="lightbox-body">
      <p class="card-group">
        <a href={`${import.meta.env.BASE_URL}groups/${groupSlug}/`}
          >{groupTitle}</a
        >

        {
          link && (
            <span>→</span>
            <a
              class="card-source"
              href={link}
              target="_blank"
              rel="noopener noreferrer"
            >
               {title} ↗
            </a>
          )
        }
      </p>
      {caption && <p class="card-caption">{caption}</p>}
      <div class="card-tags">
        {
          tags.map((tag) => (
            <a class="tag" href={`${import.meta.env.BASE_URL}tags/${tag}/`}>
              {tag}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</li>
